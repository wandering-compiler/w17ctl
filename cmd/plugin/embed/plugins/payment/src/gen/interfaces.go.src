// Package gen is the payment plugin author's compile-time contract
// with the bundle codegen — v4 plugin model. Holds the typed
// interfaces (EnvConfig, ClientSet, HandlerRegistry) the plugin's
// RegisterPlugin depends on, plus the protoc-generated bindings under
// pb/.
//
// At staging time the bundle's host codegen synthesises a parallel
// `gen/` package with the same exported types populated for the
// activation; the staging import rewrite swaps `<go_module>/gen` for
// the per-activation staged path so the authored code links against
// the codegen-emitted types with no text edits. The local gen/pb
// stubs are author-only (regenerated by `w17ctl plugin gen-pb`); the
// bundle uses its own per-activation pb.
package gen

import (
	"context"

	"github.com/wandering-compiler/sdk/go/service/secret"

	pb "github.com/MrS1lentcz/wandering-compiler/plugins/payment/gen/pb"
)

// EnvConfig is the typed view of the activation's env-var inputs. One
// PascalCase field per plugin.yaml `env:` entry. Secret-typed entries
// (`secret: true`) surface as secret.String — redacted in logs/traces,
// cleartext reachable only via .Reveal().
type EnvConfig struct {
	// PaymentProvider selects the backend driver. v1: "stripe" only;
	// any other value fails loud at RegisterPlugin.
	PaymentProvider string

	// ProviderApiKey is the provider API secret (Stripe sk_…). Passed
	// to the backend constructor via .Reveal().
	ProviderApiKey secret.String

	// WebhookSigningSecret verifies the inbound webhook HMAC (Stripe
	// whsec_…). Required when the stripe_webhooks feature is active.
	WebhookSigningSecret secret.String

	// DefaultCurrency (ISO-4217, lowercase) applies to a CreatePayment
	// that omits a currency.
	DefaultCurrency string
}

// ClientSet exposes the in-process typed clients the plugin's handlers
// depend on — the bundle's codegen emits a concrete impl per
// activation wrapping the storage servers (zero gRPC transport).
type ClientSet interface {
	PaymentQuery() pb.PaymentQueryClient
	PaymentMutation() pb.PaymentMutationClient
}

// HandlerRegistry exposes the register-service hook the plugin uses to
// plug its authored PaymentService implementation into the bundle's
// gRPC server, plus the shutdown-hook accumulator the bundle's drain
// loop walks at teardown.
type HandlerRegistry interface {
	RegisterPaymentServiceServer(impl pb.PaymentServiceServer)
	RegisterShutdown(fn func(ctx context.Context) error)
}
